# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Caches and temporary files
.pytest_cache/
*.tmp
*.temp
*.log

# Environments
.env
.venv
env/
venv/
ENV/

# IDE and Editor files
.vscode/
.idea/
*.swp
*.swo

# OS generated files
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# Runtime-generated media files
# OCR temp files (uploaded images & preprocessed versions, auto-deleted after 15 days)
data/media/ocr_*
data/media/crop_diag_*
data/media/source_*
data/media/test_*
data/media/verify_*
data/media/*_sample.*
data/media/*_cropped_*
data/.batch_checkpoint.json
# Localized question images downloaded from external platforms (VioEdu, etc.)
# Keep img_* tracked so the question bank stays self-contained on other machines
# Uncomment the line below if you prefer NOT to track them either:
# data/media/img_*

# Images for training AI to create quiz
data/training/

# Local SQLite backups (auto daily + manual snapshots) — never commit
data/backup/